{
  "name": "sleeptracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Overnight sound recording and analysis. Phase 0: survival spike.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "dev:https": "node scripts/dev-https.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "npm run lint:swift && npm run lint:format && npm run lint:dupes",
    "lint:swift": "swiftlint lint --strict --quiet",
    "lint:format": "swiftformat --lint .",
    "lint:dupes": "jscpd . --reporters console",
    "lint:fix": "swiftlint --fix --quiet && swiftformat .",
    "check": "npm test && npm run lint"
  },
  "engines": {
    "node": ">=22"
  }
}
