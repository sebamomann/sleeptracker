<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The whole reason this is a native app. A plist declaration, not a signed
         entitlement, so it works on a free personal team. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <key>NSMicrophoneUsageDescription</key>
    <string>Records the sounds of your night so they can be reviewed in the morning.</string>

    <!-- Recording runs with the screen off; there is nothing to see in landscape. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
